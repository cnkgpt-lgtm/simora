# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env ke Git.
# Contoh untuk Neon / Vercel Postgres:
# DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/simora?sslmode=require"

DATABASE_URL="postgresql://user:password@localhost:5432/simora?schema=public"

# String acak minimal 32 karakter untuk menandatangani cookie sesi.
# Buat dengan: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
